# ── Virtual environment & package caches ──────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ── Secrets (injected at runtime via Railway env vars) ─────────────────────────
.env

